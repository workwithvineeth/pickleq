{
  "name": "pickleq",
  "private": true,
  "version": "0.9.9",
  "type": "module",
  "scripts": {
    "dev": "vite --mode preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "build:live": "tsc -b && vite build --mode live --outDir dist/live",
    "build:preview": "tsc -b && vite build --mode preview --outDir dist/preview",
    "build:club": "tsc -b && vite build --mode club --outDir dist/club",
    "lint": "oxlint",
    "check": "node scripts/check.mjs",
    "robot:summary": "node e2e/summary.mjs e2e/results.json",
    "db:test": "bash scripts/db-tests.sh"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "jspdf": "4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
